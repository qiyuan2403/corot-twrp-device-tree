import /keymint.service.mitee.rc
import /tee-supplicant.rc
import /miteelog.rc
import /xiaomi.haptic.hal.rc

on init
    # Decryption needs recovery-domain SELinux permissions that AOSP's
    # system/sepolicy/private/recovery.te does not grant: keystore_service find,
    # vold_key:keystore2_key manage_blob, dm-default-key, /dev/tee0|teepriv0 and
    # FS_IOC_ADD_ENCRYPTION_KEY on /data. This tree ships no sepolicy additions,
    # so run recovery permissive (the vendor_boot cmdline also carries
    # androidboot.selinux=permissive as a belt-and-braces measure).
    write /sys/fs/selinux/enforce 0
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"
    setprop sys.usb.ffs.aio_compat 1
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw

    # KeyMint seals key blobs to the OS version and patch levels of the system
    # that created them (ro.build.version.release, ro.build.version.security_patch,
    # ro.vendor.build.security_patch). This image is built as Android 14 /
    # 2099-12-31, but the installed HyperOS 2.0.203.0.VMLCNXM is Android 15 /
    # 2025-07-01. With the mismatched identity KeyMint answers every metadata
    # and CE key operation with KEY_REQUIRES_UPGRADE and read_key fails before
    # TWRP can override these from the system partition later. Match the stock
    # identity before any security HAL starts; update this block after an OTA.
    # Matching all three values means no key upgrade happens, which is why
    # twrp-patches-vold/0001 must restore the empty-upgraded-blob guard in
    # system/vold/KeyStorage.cpp.
    exec - root root -- /system/bin/resetprop ro.build.version.release 15
    exec - root root -- /system/bin/resetprop ro.build.version.release_or_codename 15
    exec - root root -- /system/bin/resetprop ro.build.version.security_patch 2025-07-01
    exec - root root -- /system/bin/resetprop ro.vendor.build.security_patch 2025-07-01

on fs
    install_keyring
    # tee-supplicant.rc was imported above, so its own 'on fs' starts
    # tee-supplicant before this action runs. KeyMint is started by the
    # init.svc.tee-supplicant=running trigger below, after the secure-storage
    # partitions mounted in 'on early-fs' are in place.
    setprop crypto.ready 1

# We need vold early for metadata encryption.
# tee-supplicant also needs /mnt/vendor/persist mounted before it starts: the path
# is hardcoded in the binary, the stock fstab.mt6985 mounts persist there only under
# 'on late-fs' (which recovery init never triggers), and tee-supplicant.rc is
# imported above so its own 'on fs' (which starts tee-supplicant) runs before this
# file's 'on fs'. Mounting in early-fs guarantees ordering.
on early-fs
    mkdir /mnt/vendor/persist 0755 system system
    mount_all /system/etc/persist.fstab --early
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/data 0755 system system
    mkdir /mnt/vendor/persist/fdsd 0755 system system

    # MediaTek MiTEE stores the secure-deletion secret used to unwrap the
    # metadata key on these partitions. Stock init mounts them before KeyMint;
    # recovery's minimal init does not. Without them the KeyMint TA returns
    # -33 INVALID_KEY_BLOB even though the blob is valid. Mount before vold and
    # before keymint starts.
    mkdir /mnt/vendor/protect_f 0755 root root
    mkdir /mnt/vendor/protect_s 0755 root root
    mkdir /mnt/vendor/nvdata 0755 root root
    mkdir /mnt/vendor/nvcfg 0755 root root
    wait /dev/block/by-name/protect1 5
    wait /dev/block/by-name/protect2 5
    wait /dev/block/by-name/nvdata 5
    wait /dev/block/by-name/nvcfg 5
    mount ext4 /dev/block/by-name/protect1 /mnt/vendor/protect_f noatime,nosuid,nodev
    mount ext4 /dev/block/by-name/protect2 /mnt/vendor/protect_s noatime,nosuid,nodev
    mount ext4 /dev/block/by-name/nvdata /mnt/vendor/nvdata noatime,nosuid,nodev
    mount ext4 /dev/block/by-name/nvcfg /mnt/vendor/nvcfg noatime,nosuid,nodev
    start vold

# NOTE: there is deliberately no 'on late-fs' here. Recovery init never triggers
# late-fs (see bootable/recovery/etc/init.rc: 'on late-init' fires early-fs, fs,
# post-fs, post-fs-data, firmware_mounts_complete, early-boot, boot - no late-fs),
# so a 'mount_all fstab.mt6985 --late' there could never run. It would also be
# wrong on purpose: fs_mgr's MOUNT_MODE_LATE pass mounts ONLY entries flagged
# 'latemount' (system/core/fs_mgr/fs_mgr.cpp:1454), and the only latemount entries
# in fstab.mt6985 are the two /data lines (:67-68) - /data must stay unmounted in
# recovery so TWRP can decrypt and mount it itself. Everything else in that fstab
# is first_stage_mount or is mounted explicitly above.

on post-fs
    start boot-hal-1-2
    
    # Support A/B feature for EMMC and UFS boot region
    # Wait for the UFS boot LUN the symlink below targets (/dev/block/sda), not
    # for /dev/block/mmcblk0boot0 -- that path is created by the next line, so
    # waiting on it always burned the full 2s timeout on every boot.
    wait /dev/block/sda 2
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b

    # Support A/B feature for combo emmc and ufs OTA update
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/platform/bootdevice/by-name/preloader_emmc_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/platform/bootdevice/by-name/preloader_emmc_b
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/platform/bootdevice/by-name/preloader_ufs_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/platform/bootdevice/by-name/preloader_ufs_b

    # Support A/B feature for combo emmc and ufs OTA update
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/by-name/preloader_emmc_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/by-name/preloader_emmc_b
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/by-name/preloader_ufs_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/by-name/preloader_ufs_b

    # to access F2FS sysfs on dm-<num> directly
    symlink /sys/fs/mifs/${dev.mnt.dev.data} /dev/sys/fs/by-name/userdata
    symlink /sys/fs/f2fs/${dev.mnt.dev.data} /dev/sys/fs/by-name/userdata

    symlink /dev/block/platform/bootdevice /dev/block/bootdevice

    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils
    start mtk.plpath.utils.link

service mtk.plpath.utils.link /system/bin/mtk_plpath_utils
    class main
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:recovery:s0


service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    class hal
    user root
    group root
    disabled
    seclabel u:r:recovery:s0
    
 service overrideprops /system/bin/overrideprops.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
    
 service mifs_hal /system/bin/mifs_hal.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
 
# TEE first. The secure-storage partitions are already mounted in early-fs,
# so KeyMint can read the secure-deletion secret when this fires.
on property:init.svc.tee-supplicant=running
    start vendor.keymint-mitee

# Gatekeeper must come after KeyMint. Starting both together produced
# intermittent -26 auth-token races on duchamp (same MiTEE stack); a 1 second
# gap gave 5/5 successful metadata + FBE decryptions there.
on property:init.svc.vendor.keymint-mitee=running
    exec - root root -- /system/bin/sleep 1
    start vendor.gatekeeper-1-0
    restart keystore2

# TEE teardown once decryption is done. The earlier blocks on
# ro.crypto.state=unsupported / =unencrypted and on crypto.ready=0 were removed:
# nothing in this tree ever writes those values (TWRP's Set_Crypto_State writes
# only ro.crypto.state=encrypted, and crypto.ready is only ever set to 1), so
# they could never fire. twrp.decrypt.done is set by TWRP after a successful
# decrypt and is the only teardown that actually happens.
on property:twrp.decrypt.done=true
    stop vendor.keymint-mitee
    stop vendor.gatekeeper-1-0
    stop tee-supplicant
    stop miteelog

on boot
    start health-hal-2-1
    start mifs_hal
    start overrideprops
    setprop sys.usb.config adb

# TWRP loads haptic.ko from /vendor_dlkm during Process_Fstab and sets this
# property before gui_init, so the vibrator HAL always sees its input device.
on property:twrp.modules.loaded=true
    start vibratorfeature-hal-service
