+// Module names treat '-' and '_' as interchangeable (modprobe folds them), but
+// the .ko file names on disk may use either separator. Fold them so a requested
+// "mediatek_drm.ko" matches a shipped "mediatek-drm.ko" and vice versa.
+static std::string Normalize_Module_Name(const std::string& name) {
+	std::string normalized(name);
+	for (auto&& c : normalized)
+		if (c == '-') c = '_';
+	return normalized;
+}
